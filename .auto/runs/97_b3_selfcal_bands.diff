+    # B3 m1 (self-training over the unlabeled year): the K=5 marks are the
+    # only labels, but the pre-span year holds thousands of the house's own
+    # events (10.9-15.3k here), so the marks can be re-estimated from the
+    # population they were meant to describe. Pseudo-label with a window far
+    # wider than the admission band (|ev - mark| <= SELF_AMP_WIN * mark, 3x
+    # the admission's REL_AMP half-width) and re-centre the admission band on
+    # that population's p10/p90 instead of on the mark's single amp estimate:
+    # the band is only +-REL_AMP around the mark, so a mark 20% off rejects
+    # the device's real events for a whole house. Duration is NOT re-derived
+    # - a wide amp window admits other appliances' long events, which would
+    # inflate a duration envelope - so the mark's REL_DUR margins are kept.
+    # Label-free: pre-span mains only, no eval and no holdout data.
+    for d in [x for x in ('kettle', 'microwave') if x in mark]:
+        p = mark[d]
+        sel = ((np.abs(ev_amp - p['amp']) <= SELF_AMP_WIN * p['amp'])
+               & (ev_dur >= REL_DUR[0] * p['dur_s'])
+               & (ev_dur <= REL_DUR[1] * p['dur_s']))
+        n = int(sel.sum())
+        if n < SELF_MIN_N:
+            print(f'   {d} self-cal: {n} pseudo-labeled pre-span events '
+                  f'(< {SELF_MIN_N}) - mark band kept')
+            continue
+        pa = ev_amp[sel]
+        a50 = float(np.percentile(pa, 50))
+        a_lo = float(np.percentile(pa, 10))
+        a_hi = float(np.percentile(pa, 90))
+        ev_band[d] = {'amp_lo': a_lo, 'amp_hi': a_hi,
+                      'dur_lo': REL_DUR[0] * p['dur_s'],
+                      'dur_hi': REL_DUR[1] * p['dur_s'],
+                      'amp_p50': a50,
+                      'dur_p50': dur_ref.get(d, p['dur_s'])}
+        print(f'   {d} self-cal: n={n} pre-span events p10-p90 '
+              f'band {a_lo:.0f}-{a_hi:.0f}W p50 {a50:.0f}W (mark {p["amp"]:.0f}W '
+              f'-> band {0.8 * p["amp"]:.0f}-{1.2 * p["amp"]:.0f}W)')
+
