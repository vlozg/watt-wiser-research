+# Cross-house physical envelope for the burst devices (B1 m4). A kettle is a
+# physically standard appliance: across the 29 labeled PRETRAINING houses the
+# mined events (.auto/cache/b1_events_v1.npz, m1 miner) sit at 1.9-4.1 kW /
+# 72-246 s over 674 kettle events. The 7 v4 holdout houses are absent from that
+# cache, so the prior is transfer-clean. A home whose calibration mark falls
+# outside this envelope by more than a factor of 2.5 did not press this device
+# in its K=5 windows - the window caught a program appliance instead - and the
+# same windows are what _burst_event_bands mines, so the mined population is
+# junk too. Repair the mark into the envelope and let it, not the mined
+# population, gate the device.
+_XH_BURST_DEVS = ('kettle', 'microwave')
+_XH_AMP_DEVS = ('kettle',)        # flat draw: peak_w ~ the mark's median draw
+_XH_SLACK = (0.4, 2.0)            # envelope = p10/p90 x these (generous)
+
+
+def _xhouse_burst_env() -> dict:
+    """Per-device (amp_lo, amp_hi, amp_med, dur_lo, dur_hi, dur_med) from the
+    cached cross-house mined events; empty if that cache is unavailable."""
+    if _XH_ENV_CACHE:
+        return _XH_ENV_CACHE
+    try:
+        _f = (Path(__file__).resolve().parents[3] / '.auto' / 'cache'
+              / 'b1_events_v1.npz')
+        _z = np.load(_f, allow_pickle=True)
+        _dev = _z['dev']
+        _dur = _z['dur_s'].astype(float)
+        _pk = _z['peak_w'].astype(float)
+        _names = [str(_x) for _x in _z['device_names']]
+    except Exception:
+        _XH_ENV_CACHE['_unavailable'] = 1
+        return _XH_ENV_CACHE
+    for _i, _nm in enumerate(_names):
+        _m = _dev == _i
+        if int(_m.sum()) < 20:
+            continue
+        _XH_ENV_CACHE[_nm] = (
+            _XH_SLACK[0] * float(np.percentile(_pk[_m], 10)),
+            _XH_SLACK[1] * float(np.percentile(_pk[_m], 90)),
+            float(np.median(_pk[_m])),
+            _XH_SLACK[0] * float(np.percentile(_dur[_m], 10)),
+            _XH_SLACK[1] * float(np.percentile(_dur[_m], 90)),
+            float(np.median(_dur[_m])))
+    return _XH_ENV_CACHE
+
+
+_XH_ENV_CACHE = {}
